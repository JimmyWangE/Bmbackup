# 复制为 .env 后填写。.env 不要提交到 Git。

# ---- 必填 ----
# API 的域名（需要先把这个域名的 A 记录指向服务器 IP），例如 api.example.com
DOMAIN=
# 数据库密码：openssl rand -hex 24
POSTGRES_PASSWORD=
# 令牌签名密钥，至少 32 位：openssl rand -hex 32
SECRET_KEY=

# ---- 邮箱验证码 ----
# smtp：真正发邮件；console：只打印到日志（仅调试用）
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 465 端口填 true；587 端口（STARTTLS）填 false
SMTP_USE_SSL=false
MAIL_FROM=BM <no-reply@example.com>

# ---- 照片和语音 ----
# local：存在服务器的 media 卷里；s3：存在 S3 / Cloudflare R2 等对象存储
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- 可选 ----
WEB_WORKERS=2
